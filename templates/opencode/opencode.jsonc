{
  "$schema": "https://opencode.ai/config.json",

  // Referensi clean install. install.sh menghasilkan pengaturan setara dalam
  // blok terkelola. Jangan taruh token atau API key di file ini.
  "username": "{{USER_NAME}}",
  "share": "disabled",

  "permission": {
    "external_directory": {
      "{{VAULT_PATH}}/**": "allow"
    },
    "edit": {
      "*": "allow",
      "{{VAULT_PATH}}/**": "ask"
    }
  }
}
